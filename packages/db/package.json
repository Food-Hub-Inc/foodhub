{
  "name": "@foodhub/db",
  "version": "0.1.0",
  "private": true,
  "description": "Modelo de persistencia de FoodHub: schema Drizzle derivado del diagrama de clases DG12082026_V5 y migraciones de PostgreSQL/PostGIS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "production": "./dist/schema/index.js",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foodhub/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
