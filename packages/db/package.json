{
  "name": "@foodhub/db",
  "version": "0.1.0",
  "private": true,
  "description": "Modelo de persistencia de FoodHub: schema Drizzle derivado del diagrama de clases DG12082026_V4 y migraciones de PostgreSQL/PostGIS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foodhub/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
