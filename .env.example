# =============================================================================
#  FoodHub - Plantilla de variables de entorno
# =============================================================================
#  Copiar como `.env` y completar con los valores reales. El `.env` NUNCA se
#  commitea (ver .gitignore). Los valores de cada ambiente se obtienen siguiendo
#  el documento "FoodHub - Configuraciones manuales del entorno de desarrollo".
#
#  APP_ENV distingue el ambiente y determina contra que proyecto de Supabase y
#  que servicio de Railway apunta cada aplicacion.
# =============================================================================

# development | production
APP_ENV=development
NODE_ENV=development


# -----------------------------------------------------------------------------
#  SUPABASE  (proyecto foodhub-dev en desarrollo, foodhub-prod en produccion)
# -----------------------------------------------------------------------------
# Panel de Supabase -> Project Settings -> Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publica (publishable). Puede viajar al cliente: el acceso real lo
# controlan las politicas RLS de la base.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clave secreta. SOLO en el backend: ignora RLS por completo.
# Si se filtra, se expone toda la base. Nunca ponerla en apps/mobile ni apps/admin.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Cadena de conexion directa a PostgreSQL, usada por Drizzle para migraciones.
# Panel de Supabase -> Connect -> ORMs. Usar el pooler en produccion.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Secreto del Auth Hook que alimenta la tabla evento_seguridad (US-AUD-01).
# Panel de Supabase -> Authentication -> Hooks.
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
#  API  (apps/api)
# -----------------------------------------------------------------------------
PORT=3000
API_BASE_URL=http://localhost:3000

# Origenes autorizados para CORS, separados por coma.
# En produccion se restringe al dominio del panel admin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Ventana y tope del rate limiting (modulo de seguridad, alcance 2.2.2.2.1).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Minutos que espera un pedido sin respuesta del cocinero antes de pasar a
# rechazado automaticamente (US-PED-10). Parametrizable desde el panel admin.
PEDIDO_EXPIRACION_MINUTOS=15


# -----------------------------------------------------------------------------
#  ALMACENAMIENTO DE IMAGENES  (Supabase Storage)
# -----------------------------------------------------------------------------
STORAGE_BUCKET_PERFILES=perfiles
STORAGE_BUCKET_PUBLICACIONES=publicaciones
STORAGE_MAX_FILE_SIZE_MB=5


# -----------------------------------------------------------------------------
#  NOTIFICACIONES PUSH  (Firebase Cloud Messaging + Expo)
# -----------------------------------------------------------------------------
# Ruta al JSON de la cuenta de servicio de Firebase (fuera del repositorio).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FCM_PROJECT_ID=foodhub-dev
EXPO_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
#  MAPAS  (Google Maps Platform)
# -----------------------------------------------------------------------------
# Restringir por SHA-1 del paquete Android antes de pasar a produccion.
GOOGLE_MAPS_ANDROID_API_KEY=


# -----------------------------------------------------------------------------
#  CLIENTES  -  Solo variables con prefijo publico
# -----------------------------------------------------------------------------
#  Todo lo que lleve EXPO_PUBLIC_ o VITE_ queda EMBEBIDO en el bundle y es
#  legible por cualquiera que descargue la app. Nunca poner secretos aca.

# apps/mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# apps/admin (Vite)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
