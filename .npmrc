# React Native y Metro no resuelven correctamente los symlinks anidados que
# pnpm usa por defecto. "hoisted" replica el layout plano de npm dentro de
# node_modules, que es el unico soportado por Expo en monorepos con pnpm.
node-linker=hoisted

# Evita que un paquete use una dependencia que no declaro explicitamente.
strict-peer-dependencies=false

# Expo y React Native publican rangos de peers muy amplios; sin esto pnpm
# aborta la instalacion ante discrepancias menores que no afectan el runtime.
auto-install-peers=true
