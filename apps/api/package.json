{
  "name": "@foodhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de FoodHub. Node.js + Express 5 + Drizzle ORM sobre PostgreSQL/PostGIS.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foodhub/db": "workspace:*",
    "@foodhub/shared": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "catalog:",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "^26.2.0",
    "supertest": "7.2.2",
    "@types/supertest": "7.2.1",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
