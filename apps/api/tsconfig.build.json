{
  // Configuracion usada solo por `pnpm build`: a diferencia del tsconfig de
  // desarrollo, si emite JavaScript y excluye del bundle las pruebas y la
  // configuracion de vitest.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "vitest.config.ts"
  ]
}
